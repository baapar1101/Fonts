# Copy to ".env" and fill in. ".env" is gitignored — never commit it.

# OTP service. It generates, texts and verifies the login codes, so this
# project holds no SMS credentials of any kind. Calls are made server-side
# only; nothing here is ever exposed to the browser.
OTP_API_BASE=https://otp.eldery.ir

# Phone numbers allowed into the admin panel (comma-separated).
ADMIN_PHONES=09901046596

# Interpreter that has fontTools installed, used to process uploads.
PYTHON=python

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=8642
