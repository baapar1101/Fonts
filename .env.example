# Copy to ".env" and fill in real values. ".env" is gitignored — never commit it.

# --- Rastin SMS gateway (used to deliver login codes) ---
SMS_ENDPOINT=https://www.rastinsms.com/APISend.aspx
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM=

# Set to 1 to print the login code to the server console instead of sending an
# SMS. Use this while developing so you don't spend credit on every login.
SMS_DEV=1

# Signs session tokens and hashes one-time codes.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=8642
