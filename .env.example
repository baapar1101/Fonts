# Copy to ".env" and fill in. ".env" is gitignored — never commit it.

# Payam Resan V3 SMS API. Keep the key only in .env on the server.
SMS_API_BASE=https://api.sms-webservice.com/api/V3
SMS_API_KEY=
SMS_SENDER=

# Phone numbers allowed into the admin panel (comma-separated).
ADMIN_PHONES=09901046596

# Interpreter that has fontTools installed, used to process uploads.
PYTHON=python

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=8643
